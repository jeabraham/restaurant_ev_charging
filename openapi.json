{
  "openapi": "3.1.0",
  "info": {
    "title": "Restaurant EV Charging API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://web-production-1f8a2.up.railway.app"
    }
  ],
  "paths": {
    "/find-dining-chargers": {
      "post": {
        "summary": "Find Dining Chargers",
        "description": "Find EV chargers within walking distance of restaurants. Always call this before recommending any charger or restaurant pair. Use when the user asks about dining while charging or charging stops. Geocode the location if needed.",
        "operationId": "find_dining_chargers_find_dining_chargers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindDiningChargersRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "search": {
                      "type": "object",
                      "properties": {
                        "latitude": {
                          "type": "number"
                        },
                        "longitude": {
                          "type": "number"
                        },
                        "radius_km": {
                          "type": "number"
                        },
                        "restaurant_radius_m": {
                          "type": "integer"
                        },
                        "preferred_radius_m": {
                          "type": "integer",
                          "description": "Effective near/far boundary used for tiering (clamped to restaurant_radius_m)."
                        }
                      }
                    },
                    "search_location": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tier": {
                            "type": "string",
                            "enum": [
                              "primary",
                              "distant_good",
                              "slow_charger",
                              "fast_food",
                              "other"
                            ],
                            "description": "Recommendation tier. 'primary' = good independent restaurant within preferred_radius_m of a DC fast charger \u2014 recommend these first. When none exist, offer the fallbacks: 'distant_good' (good restaurant, longer walk to a fast charger), 'slow_charger' (good restaurant at a slow L2 charger), 'fast_food' (highly-rated fast food/chain near a fast charger). 'other' = more heavily compromised."
                          },
                          "restaurant": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "address": {
                                "type": "string",
                                "nullable": true
                              },
                              "latitude": {
                                "type": "number"
                              },
                              "longitude": {
                                "type": "number"
                              },
                              "website": {
                                "type": "string",
                                "nullable": true
                              },
                              "google_maps_url": {
                                "type": "string",
                                "description": "Google Maps link for the restaurant. Anchored to the exact business via query_place_id when a Google place_id is known; otherwise a coordinate-based search link (e.g. Geoapify-only results or no Google Places API key). Use this for the restaurant link."
                              },
                              "reviews": {
                                "type": "object",
                                "description": "Third-party review data. Present only when a matching business was found. Use rating, review_count, cuisine_types, and is_open_now when ranking and recommending restaurants.",
                                "nullable": true,
                                "properties": {
                                  "rating": {
                                    "type": "number",
                                    "description": "Average rating (e.g. 1\u20135 for Yelp)."
                                  },
                                  "review_count": {
                                    "type": "integer",
                                    "description": "Number of reviews."
                                  },
                                  "price_level": {
                                    "type": "string",
                                    "nullable": true,
                                    "description": "Price level indicator, e.g. '$', '$$', '$$$', '$$$$'."
                                  },
                                  "cuisine_types": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "Cuisine or category labels from the review provider."
                                  },
                                  "is_open_now": {
                                    "type": "boolean",
                                    "nullable": true,
                                    "description": "TRANSIENT current open-now status. Null if unknown. Ignore this unless the user is arriving right now \u2014 users usually plan a future stop, so this should not drive recommendations."
                                  },
                                  "business_status": {
                                    "type": "string",
                                    "nullable": true,
                                    "enum": [
                                      "OPERATIONAL",
                                      "CLOSED_TEMPORARILY",
                                      "CLOSED_PERMANENTLY"
                                    ],
                                    "description": "Durable operating status. CLOSED_PERMANENTLY businesses are excluded from results; CLOSED_TEMPORARILY should be flagged to the user. Null if unknown."
                                  },
                                  "weekday_text": {
                                    "type": "array",
                                    "nullable": true,
                                    "items": {
                                      "type": "string"
                                    },
                                    "description": "Human-readable weekly opening hours, e.g. ['Monday: 9:00 AM \u2013 5:00 PM', ...]. Use to tell the user which meals (breakfast/lunch/dinner) or days a place is closed. Null when hours are unavailable (Geoapify-only result, no Google Places key, or hours lookup disabled)."
                                  },
                                  "is_fast_food": {
                                    "type": "boolean",
                                    "description": "Whether the restaurant is classified as fast food by the review provider."
                                  },
                                  "provider_url": {
                                    "type": "string",
                                    "description": "Direct link to the restaurant's page on the review provider."
                                  },
                                  "provider": {
                                    "type": "string",
                                    "description": "Review data source, e.g. 'yelp'."
                                  }
                                }
                              }
                            }
                          },
                          "charger": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "network": {
                                "type": "string",
                                "nullable": true
                              },
                              "maximum_power_kw": {
                                "type": "number"
                              },
                              "charger_speed": {
                                "type": "string",
                                "enum": [
                                  "DC_FAST",
                                  "L2",
                                  "UNKNOWN"
                                ],
                                "description": "Charger speed class. 'DC_FAST' (>=50 kW) suits a dining stop; 'L2' is slow (overnight only); 'UNKNOWN' for Google Places fallback chargers with no power data."
                              },
                              "is_fast_charger": {
                                "type": "boolean",
                                "description": "True when charger_speed is DC_FAST."
                              },
                              "status": {
                                "type": "string"
                              },
                              "compatibility_notes": {
                                "type": "string",
                                "nullable": true
                              },
                              "openchargemap_url": {
                                "type": "string"
                              }
                            }
                          },
                          "distance": {
                            "type": "object",
                            "properties": {
                              "straight_line_metres": {
                                "type": "number"
                              },
                              "estimated_walking_time_minutes": {
                                "type": "integer"
                              },
                              "google_maps_walking_url": {
                                "type": "string"
                              }
                            }
                          },
                          "other_close_chargers": {
                            "type": "array",
                            "description": "Other chargers also within walking distance of this restaurant, sorted by distance. Omitted when none exist.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "openchargemap_url": {
                                  "type": "string"
                                },
                                "straight_line_metres": {
                                  "type": "number"
                                },
                                "estimated_walking_time_minutes": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "diagnostics": {
                      "type": "object",
                      "properties": {
                        "qualifying_chargers": {
                          "type": "integer"
                        },
                        "qualifying_restaurant_charger_pairs": {
                          "type": "integer"
                        },
                        "tier_counts": {
                          "type": "object",
                          "description": "Number of returned results in each recommendation tier (keys: primary, distant_good, slow_charger, fast_food, other).",
                          "additionalProperties": {
                            "type": "integer"
                          }
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/geo/geocode": {
      "get": {
        "summary": "Geo Geocode",
        "operationId": "geo_geocode_api_geo_geocode_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Free-form place query text."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 10
            },
            "description": "Max results (default 5, capped at 10)."
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Optional language code."
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Optional Geoapify filter expression."
          },
          {
            "name": "bias",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Optional Geoapify bias expression."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoGeocodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Client validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Missing Geoapify API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream Geoapify error or timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/geo/route": {
      "post": {
        "summary": "Geo Route",
        "operationId": "geo_route_api_geo_route_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeoRouteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoRouteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Client validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Missing Geoapify API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream Geoapify error or timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FindDiningChargersRequest": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "description": "Latitude of the search centre in decimal degrees. Geocode the user's location if they provided a city or place name."
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "description": "Longitude of the search centre in decimal degrees. Geocode the user's location if they provided a city or place name."
          },
          "radius_km": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Radius Km",
            "default": 10,
            "description": "Search radius in kilometres around the centre point. Default 10 km is suitable for a town; increase for rural areas."
          },
          "restaurant_radius_m": {
            "type": "integer",
            "maximum": 2000.0,
            "exclusiveMinimum": 0.0,
            "title": "Restaurant Radius M",
            "default": 500,
            "description": "Maximum walking distance in metres between a charger and a restaurant. Default 500 m (~6 min walk). Set to 2000 to also surface the 'distant_good' fallback tier."
          },
          "preferred_radius_m": {
            "type": "integer",
            "maximum": 2000.0,
            "exclusiveMinimum": 0.0,
            "title": "Preferred Radius M",
            "default": 800,
            "description": "Comfortable walking distance in metres separating a 'primary' recommendation from the 'distant_good' fallback. Default 800 m (~10 min walk). Clamped to restaurant_radius_m."
          },
          "nacs": {
            "type": "boolean",
            "title": "Nacs",
            "default": true,
            "description": "Include NACS (North American Charging Standard / Tesla-compatible) chargers."
          },
          "ccs": {
            "type": "boolean",
            "title": "Ccs",
            "default": true,
            "description": "Include CCS (Combined Charging System) DC fast chargers."
          },
          "tesla_only": {
            "type": "boolean",
            "title": "Tesla Only",
            "default": false,
            "description": "Restrict results to Tesla Supercharger network only. Overrides nacs and ccs filters when true."
          },
          "include_fast_food": {
            "type": "boolean",
            "title": "Include Fast Food",
            "default": true,
            "description": "Include fast-food/chain restaurants in results (still labeled via reviews.is_fast_food and the 'fast_food' tier). Set false to exclude them entirely. Keep true so the fast-food fallback tier is available when no good independent restaurant exists."
          },
          "max_results": {
            "type": "integer",
            "maximum": 200,
            "exclusiveMinimum": 0,
            "title": "Max Results",
            "default": 30,
            "description": "Maximum number of charger-restaurant pairs to return. Keep low (10-15) to avoid response size limits."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "FindDiningChargersRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "RouteWaypoint": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false,
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "GeoRouteRequest": {
        "type": "object",
        "required": [
          "waypoints"
        ],
        "additionalProperties": false,
        "properties": {
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/RouteWaypoint"
            }
          },
          "mode": {
            "type": "string",
            "default": "drive",
            "minLength": 1,
            "maxLength": 64
          },
          "details": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "GeoErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "upstream_status": {
                "type": "integer"
              }
            }
          }
        }
      },
      "GeoGeocodeResult": {
        "type": "object",
        "required": [
          "formatted",
          "coordinates",
          "components",
          "provider"
        ],
        "properties": {
          "formatted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "coordinates": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lon": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "components": {
            "type": "object",
            "required": [
              "country",
              "state",
              "city",
              "postcode"
            ],
            "properties": {
              "country": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "city": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "postcode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "provider": {
            "type": "object",
            "required": [
              "place_id",
              "result_type",
              "rank"
            ],
            "properties": {
              "place_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "result_type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "GeoGeocodeResponse": {
        "type": "object",
        "required": [
          "query",
          "total",
          "results"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoGeocodeResult"
            }
          }
        }
      },
      "GeoRouteStep": {
        "type": "object",
        "required": [
          "instruction",
          "distance_m",
          "duration_s",
          "from_index",
          "to_index"
        ],
        "properties": {
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "from_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "to_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GeoRouteLeg": {
        "type": "object",
        "required": [
          "distance_m",
          "duration_s",
          "steps"
        ],
        "properties": {
          "distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoRouteStep"
            }
          }
        }
      },
      "GeoRouteResponse": {
        "type": "object",
        "required": [
          "mode",
          "total_distance_m",
          "total_duration_s",
          "geometry",
          "polyline",
          "legs"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "total_distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "geometry": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "polyline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoRouteLeg"
            }
          }
        }
      }
    }
  }
}
